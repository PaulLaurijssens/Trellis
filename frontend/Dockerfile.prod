# Production image for the Trellis frontend. Differs from the dev Dockerfile on purpose:
#  - npm ci from package-lock.json (reproducible) instead of npm install
#  - next build + next start instead of next dev
#  - code IN the image, no bind mount
#  - NEXT_PUBLIC_API_URL is a BUILD arg: Next bakes NEXT_PUBLIC_* values into the bundle,
#    so setting it at runtime does nothing. Default "/api" => same origin, no CORS, and the
#    PWA talks to the origin it came from.
ARG NODE_VERSION=22.23.2
FROM node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /app

# Optional package mirror for networks that block or filter registry.npmjs.org. Empty = the normal registry.
ARG NPM_CONFIG_REGISTRY=
COPY package.json package-lock.json ./
RUN [ -n "$NPM_CONFIG_REGISTRY" ] || unset NPM_CONFIG_REGISTRY; npm ci

COPY . .
ARG NEXT_PUBLIC_API_URL=/api
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

# --chown is not optional: COPY otherwise takes over the permissions of the build context,
# and a context with 0640 files gives an image in which the non-root user cannot read its
# own package.json (EACCES at start). Numeric ids may come before the useradd below.
COPY --from=build --chown=10003:10003 /app/node_modules ./node_modules
COPY --from=build --chown=10003:10003 /app/.next ./.next
COPY --from=build --chown=10003:10003 /app/public ./public
COPY --from=build --chown=10003:10003 /app/package.json ./package.json
COPY --from=build --chown=10003:10003 /app/next.config.js ./next.config.js

RUN groupadd -g 10003 trellis && useradd -u 10003 -g 10003 -m -s /usr/sbin/nologin trellis
USER 10003:10003

# Version and commit, set by the release workflow; a local build says "dev".
ARG TRELLIS_VERSION=dev
ARG TRELLIS_COMMIT=
ENV TRELLIS_VERSION=${TRELLIS_VERSION} \
    TRELLIS_COMMIT=${TRELLIS_COMMIT}
LABEL org.opencontainers.image.source="https://github.com/PaulLaurijssens/Trellis" \
      org.opencontainers.image.title="trellis-frontend" \
      org.opencontainers.image.version="${TRELLIS_VERSION}" \
      org.opencontainers.image.revision="${TRELLIS_COMMIT}"

EXPOSE 3000
CMD ["npm", "run", "start"]
