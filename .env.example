# Trellis settings. Only the first line is required; the setup screen at http://localhost:8080 does the rest.

# Protects the database inside Docker. Any long random string; you never type it.
NEO4J_PASSWORD=change-me

# --- Optional. Everything below can also be set in the setup screen. ---
# Model provider key(s). Set here if you prefer a file over the setup screen (a server, for example).
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MISTRAL_API_KEY=
# Model names (LiteLLM format). Defaults per provider are in backend/app/providers.py.
# MENTOR_MODEL=gemini/gemini-3.1-pro-preview
# EXTRACT_MODEL=gemini/gemini-3.7-flash
# EMBED_MODEL=gemini/gemini-embedding-2-preview
# EMBED_DIM=3072

# Interactive lessons: on | pilot | off
# TEACH_MODE=on
# Lesson cost controls. A lesson job stops at TEACH_MAX_TOKENS (the last validated version still ships).
# The plan step reads the workspace with the cheap model first; set TEACH_PLAN=0 to skip it.
# TEACH_MAX_TOKENS=220000
# TEACH_PLAN=1
# TEACH_PLAN_MODEL=gemini/gemini-3.7-flash
# Prices for the cost card only (USD per million tokens); the table in backend/app/teach/orchestrator.py is the default.
# TEACH_PRICE_IN=2
# TEACH_PRICE_OUT=12
# Where Trellis listens. Keep 127.0.0.1 unless you put HTTPS in front of it (docs/VPS.md).
# TRELLIS_BIND=127.0.0.1
# TRELLIS_PORT=8080
# Backups: nightly hour (UTC) and how many to keep.
# BACKUP_HOUR_UTC=3
# BACKUP_KEEP=14
