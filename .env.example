NEO4J_PASSWORD=changeme123
NEO4J_USER=neo4j

# LLM-agnostisch via LiteLLM. Wisselen = alleen deze regels aanpassen.
# Twee taken, twee modellen:
#   EXTRACT_MODEL - concept-extractie en entity resolution. Volume-werk, dus flash.
#   MENTOR_MODEL  - antwoorden in /ask. Vraagt om redeneerkracht, dus pro.
# Kan later naar anthropic/claude-sonnet-4-6 (zet dan ANTHROPIC_API_KEY hieronder).
EXTRACT_MODEL=gemini/gemini-3.7-flash
MENTOR_MODEL=gemini/gemini-3.1-pro-preview

# Embeddings: definitief kiezen VOOR je de graph vult (ruimtes zijn onderling incompatibel).
# EMBED_DIM moet matchen met de vector-index in db/schema.cypher (nu 3072).
# Afschalen (3072 -> 1536) kan later zonder opnieuw embedden; opschalen niet.
EMBED_MODEL=gemini/gemini-embedding-2-preview
EMBED_DIM=3072

GEMINI_API_KEY=
# Nodig zodra MENTOR_MODEL op anthropic/claude-sonnet-4-6 gezet wordt.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
