# Production image for the Trellis API. Differs from the dev Dockerfile on purpose:
#  - pinned base + pinned requirements (reproducible)
#  - code IN the image, no bind mount: what runs is what was built
#  - no --reload: it watches the whole tree and costs memory
#  - non-root user
# Exact patch + digest. "3.12-slim-bookworm" was a floating tag, and every build pulled the
# newest. 3.12.14 is what the first successful build used (PYTHON_VERSION in the image env);
# the digest was verified against Docker Hub (2026-09-19). To update: replace tag and digest together.
FROM python:3.12.14-slim-bookworm@sha256:d5ae74acb8026b32a2f6deea45003c5bd4e2880700c19c44bda54670ad3eff90

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Optional package mirror for networks that block or filter pypi.org. Empty = the normal index.
ARG PIP_INDEX_URL=
COPY requirements.lock.txt ./
RUN [ -n "$PIP_INDEX_URL" ] || unset PIP_INDEX_URL; pip install --no-cache-dir -r requirements.lock.txt

# --chown for the same reason as in the frontend image: COPY inherits the permissions of
# the build context, and without it the non-root user cannot read its own source code.
COPY --chown=10002:10002 app ./app

RUN groupadd -g 10002 trellis && useradd -u 10002 -g 10002 -m -s /usr/sbin/nologin trellis
USER 10002:10002

# Version and commit for GET /health. Set by the release workflow; a local build says "dev".
# Late in the file so a new version does not rebuild the layers above.
ARG TRELLIS_VERSION=dev
ARG TRELLIS_COMMIT=
ENV TRELLIS_VERSION=${TRELLIS_VERSION} \
    TRELLIS_COMMIT=${TRELLIS_COMMIT}
LABEL org.opencontainers.image.source="https://github.com/PaulLaurijssens/Trellis" \
      org.opencontainers.image.title="trellis-api" \
      org.opencontainers.image.version="${TRELLIS_VERSION}" \
      org.opencontainers.image.revision="${TRELLIS_COMMIT}"

EXPOSE 8000
# One worker: this is a personal app. More workers = more memory and more Neo4j
# connections, with nobody waiting for them.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
